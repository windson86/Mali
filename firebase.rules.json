{
  "rules": {
    ".read": false,
    ".write": false,
    "colorLessons": {
      "v1": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$lessonId": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['rgb', 'label', 'source', 'created_at', 'server_at'])",
            "rgb": {
              "0": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 255 && newData.val() % 1 === 0"
              },
              "1": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 255 && newData.val() % 1 === 0"
              },
              "2": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 255 && newData.val() % 1 === 0"
              },
              ".validate": "newData.hasChildren(['0', '1', '2'])",
              "$other": {
                ".validate": false
              }
            },
            "label": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
            },
            "source": {
              ".validate": "newData.isString() && (newData.val() === 'teaching' || newData.val() === 'verification')"
            },
            "created_at": {
              ".validate": "newData.isString() && newData.val().length > 10 && newData.val().length <= 40"
            },
            "server_at": {
              ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "gameConfig": {
      "public": {
        ".read": true,
        ".write": false
      }
    },
    "colorFeedback": {
      "v1": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$feedbackId": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['rgb', 'source', 'created_at', 'server_at'])",
            "rgb": {
              "0": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 255 && newData.val() % 1 === 0"
              },
              "1": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 255 && newData.val() % 1 === 0"
              },
              "2": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 255 && newData.val() % 1 === 0"
              },
              ".validate": "newData.hasChildren(['0', '1', '2'])",
              "$other": {
                ".validate": false
              }
            },
            "source": {
              ".validate": "newData.isString() && (newData.val() === 'teaching' || newData.val() === 'verification')"
            },
            "created_at": {
              ".validate": "newData.isString() && newData.val().length > 10 && newData.val().length <= 40"
            },
            "server_at": {
              ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "navigationLessons": {
      "v1": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$routeId": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && $routeId.matches(/^maze-[a-z0-9-]{12,60}$/)",
            ".validate": "newData.hasChildren(['size','start','goals','actions','moves','hits','optimal_steps','config_revision','created_at','server_at'])",
            "size": {
              ".validate": "newData.isNumber() && (newData.val() === 8 || newData.val() === 12 || newData.val() === 16)"
            },
            "start": {
              "0": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
              },
              "1": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
              },
              ".validate": "newData.hasChildren(['0','1'])",
              "$other": {
                ".validate": false
              }
            },
            "goals": {
              ".validate": "newData.hasChild('0')",
              "$index": {
                "0": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
                },
                "1": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
                },
                ".validate": "$index.matches(/^[0-2]$/) && newData.hasChildren(['0','1'])",
                "$other": {
                  ".validate": false
                }
              }
            },
            "walls": {
              "$index": {
                ".validate": "$index.matches(/^([0-9]|[1-8][0-9])$/) && newData.isString() && newData.val().length >= 3 && newData.val().length <= 5"
              }
            },
            "actions": {
              ".validate": "newData.hasChild('0')",
              "$index": {
                ".validate": "$index.matches(/^([0-9]|[1-9][0-9]|[1-7][0-9][0-9])$/) && newData.hasChildren(['action','from','to','blocked','target','target_index'])",
                "action": {
                  ".validate": "newData.isString() && (newData.val() === 'up' || newData.val() === 'down' || newData.val() === 'left' || newData.val() === 'right')"
                },
                "from": {
                  "0": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
                  },
                  "1": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
                  },
                  ".validate": "newData.hasChildren(['0','1'])",
                  "$other": {
                    ".validate": false
                  }
                },
                "to": {
                  "0": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
                  },
                  "1": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
                  },
                  ".validate": "newData.hasChildren(['0','1'])",
                  "$other": {
                    ".validate": false
                  }
                },
                "target": {
                  "0": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
                  },
                  "1": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
                  },
                  ".validate": "newData.hasChildren(['0','1'])",
                  "$other": {
                    ".validate": false
                  }
                },
                "blocked": {
                  ".validate": "newData.isBoolean()"
                },
                "target_index": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 2"
                },
                "known_walls": {
                  "$index": {
                    ".validate": "$index.matches(/^([0-9]|[1-8][0-9])$/) && newData.isString() && newData.val().length >= 3 && newData.val().length <= 5"
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "moves": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 800"
            },
            "hits": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 800"
            },
            "optimal_steps": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 800"
            },
            "config_revision": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0"
            },
            "created_at": {
              ".validate": "newData.isString() && newData.val().length > 10 && newData.val().length <= 40"
            },
            "server_at": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
